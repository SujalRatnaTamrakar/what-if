# PlacePatch backend config — copy to backend/.env and fill in.
# Source of truth for every value: docs/MASTER_PLAN.md §6.1
# NEVER commit backend/.env or any file containing secrets.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,api.placepatch.xyz
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
CORS_ALLOW_ALL_DEV=true
PUBLIC_BASE_URL=https://xyz.trycloudflare.com
APP_PUBLIC_WEB_URL=
DATABASE_URL=postgres://user:pass@host:5432/placepatch?sslmode=require
MEDIA_ROOT=./media
MEDIA_URL_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_EDGE=2048
AUTH0_DOMAIN=placepatch.us.auth0.com
AUTH0_AUDIENCE=https://api.placepatch.dev
AUTH_DEV_BYPASS=false
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=2
WORKER_POLL_SECONDS=1
SCENE_PROVIDER=fallback
DRAFT_PROVIDER=fallback
REVIEW_PROVIDER=fallback
RENDER_PROVIDER=fallback
# Fallback chains: tried in order on transient errors only (429/503/504,
# retired-model 404s, timeouts, connection errors). Validation errors surface.
SCENE_CHAIN=gemini,openai,ollama
DRAFT_CHAIN=gemini,openai,ollama
REVIEW_CHAIN=gemini,openai,ollama
RENDER_CHAIN=gemini_image,openai_image,comfyui
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=90
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TIMEOUT_SECONDS=60
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKFLOW=workflows/shade_inpaint_v1.api.json
COMFYUI_TIMEOUT_SECONDS=240
RENDER_WORK_EDGE=1024
RENDER_FEATHER_PX=12
ANALYTICS_ENABLED=true
