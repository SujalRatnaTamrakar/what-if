# WhatIf mobile config — copy to mobile/.env and fill in.
# Source of truth: docs/MASTER_PLAN.md §6.2
# Read ONLY in mobile/src/config.ts. EXPO_PUBLIC_* values ship inside the app
# bundle, so NEVER put secrets here.

EXPO_PUBLIC_API_MODE=fixture
EXPO_PUBLIC_API_BASE_URL=https://xyz.trycloudflare.com/api/v1
EXPO_PUBLIC_AUTH0_DOMAIN=whatif.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.whatif.dev
EXPO_PUBLIC_AUTH0_SCHEME=whatif
EXPO_PUBLIC_JOB_POLL_MS=2000
