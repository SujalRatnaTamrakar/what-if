# WhatIf web config — copy to web/.env and fill in.
# Source of truth: docs/MASTER_PLAN.md §6.4 (mirrors config/web.env.example)
# Read ONLY in web/src/config.ts. VITE_* values ship in the bundle: NEVER put secrets here.

VITE_API_MODE=fixture
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AUTH0_DOMAIN=whatif.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.whatif.dev
VITE_JOB_POLL_MS=2000

# Web-only (not yet in §6.4): map tiles + geocoder for the Map tab / "Use my location".
# Leave VITE_GEOCODER_URL empty to turn geocoding off.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org
